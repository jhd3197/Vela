{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vela app manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "category",
    "author",
    "compatibility",
    "runtime",
    "view"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "icon": {
      "$ref": "#/$defs/path"
    },
    "color": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bridge"
      ],
      "properties": {
        "bridge": {
          "const": 1
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "static": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entry"
          ],
          "properties": {
            "entry": {
              "$ref": "#/$defs/path"
            }
          }
        },
        "process": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trust",
            "platforms"
          ],
          "properties": {
            "trust": {
              "const": "trusted-native"
            },
            "platforms": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "posix": {
                  "$ref": "#/$defs/process"
                },
                "windows": {
                  "$ref": "#/$defs/process"
                },
                "android": {
                  "$ref": "#/$defs/process"
                }
              }
            }
          }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface"
      ],
      "properties": {
        "surface": {
          "enum": [
            "embedded",
            "external",
            "none"
          ]
        },
        "chrome": {
          "enum": [
            "hub",
            "compact",
            "seamless"
          ],
          "default": "compact"
        },
        "appearance": {
          "enum": [
            "light",
            "dark",
            "auto"
          ],
          "default": "auto"
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^/\\s]+"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "surface": {
                "const": "external"
              }
            }
          },
          "then": {
            "required": [
              "url"
            ],
            "not": {
              "required": [
                "chrome"
              ]
            }
          },
          "else": {
            "not": {
              "required": [
                "url"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "surface": {
                "const": "none"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "chrome"
              ]
            }
          }
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "quotaBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 10485760
        },
        "schema": {
          "$ref": "#/$defs/path"
        },
        "legacy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "field",
            "schema"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^vela\\.[a-z0-9-]+\\."
            },
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]*$"
            },
            "schema": {
              "$ref": "#/$defs/path"
            }
          }
        },
        "migrations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "file"
            ],
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 1
              },
              "to": {
                "type": "integer",
                "minimum": 2
              },
              "file": {
                "$ref": "#/$defs/path"
              }
            }
          }
        },
        "legacyBundle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "keys",
            "field",
            "schema",
            "initial"
          ],
          "properties": {
            "keys": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 8,
              "additionalProperties": {
                "type": "string",
                "pattern": "^vela\\.[a-z0-9-]+\\."
              }
            },
            "field": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
            },
            "schema": {
              "$ref": "#/$defs/path"
            },
            "initial": {
              "type": "object"
            }
          }
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "operations"
      ],
      "properties": {
        "provider": {
          "const": "ollama"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "models.list",
              "models.show",
              "server.version"
            ]
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "effect",
          "inputSchema",
          "outputSchema",
          "handler"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "maxLength": 100
          },
          "effect": {
            "const": "write"
          },
          "inputSchema": {
            "$ref": "#/$defs/path"
          },
          "outputSchema": {
            "$ref": "#/$defs/path"
          },
          "handler": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "field",
              "initial",
              "fields"
            ],
            "properties": {
              "kind": {
                "const": "storage.append"
              },
              "field": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
              },
              "initial": {
                "type": "object"
              },
              "fields": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(?!id$)(?!updated$)[a-zA-Z][a-zA-Z0-9]*$"
                }
              }
            }
          }
        }
      }
    },
    "actionRequests": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "app",
          "action"
        ],
        "properties": {
          "app": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "widgets": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "layout",
          "size"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "layout": {
            "enum": [
              "stat",
              "progress",
              "list",
              "actions",
              "chart",
              "keyvalue"
            ]
          },
          "size": {
            "enum": [
              "s",
              "m",
              "l"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*:).+$"
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run"
      ],
      "properties": {
        "run": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    }
  }
}
