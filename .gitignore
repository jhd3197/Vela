# Secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies
node_modules/
*/node_modules/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Build output
dist/
build/
*.map
.next/
out/

# Android
*.apk
*.aab
.gradle/
local.properties
.cxx/

# Logs
*.log
logs/

# Generated README screenshots (npm run shots in web/)
docs/screenshots/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor
.idea/
.vscode/
*.swp

# Automation worker dependency tree and the record of where it came from.
# `package-lock.json` is deliberately NOT ignored: once the pinned engine is on
# the registry, committing it is what makes a release build reproducible.
/scripts/automation-worker/provenance.json

# Browser worker dependency tree and the record of the browser build it uses.
# `package-lock.json` is committed for the same reason as the automation worker's.
/scripts/browser-worker/provenance.json

# Scratch / playground
playground.py
scratch.*
.local/
*.tgz

# Local planning and implementation history (never publish)
/plans/

# Personal Claude Code overrides
/.claude/settings.local.json
